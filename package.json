{
  "name": "hlpi-facilities-cmms",
  "private": true,
  "version": "2.0.0",
  "description": "Facilities and MHE maintenance management (CMMS) for HAVI Logistics Philippines. Runs on one PC; everyone else uses a browser.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "server": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/lib/*.test.js\" \"server/test/*.test.js\"",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "fflate": "^0.8.3",
    "vite": "^5.4.6"
  }
}
